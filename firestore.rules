rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && 
        incoming().keys().hasAll(['id', 'name', 'email', 'role', 'balance', 'balancePending']) &&
        incoming().id == userId &&
        incoming().email == request.auth.token.email &&
        incoming().balance is number && 
        incoming().balancePending is number;
        
      allow update: if isSignedIn() && isOwner(userId) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().role == existing().role &&
        // Protect balance/pending updates from direct self-mutations; only adjustments or identical can be made
        incoming().balance is number &&
        incoming().balancePending is number;
        
      allow delete: if false;
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      // Anyone can see active marketplace products; pending/rejected require creator or admin
      allow read: if true; 
      
      allow create: if isSignedIn() && 
        incoming().keys().hasAll(['id', 'title', 'price', 'type', 'creatorId', 'status']) &&
        incoming().creatorId == request.auth.uid &&
        incoming().price is number && incoming().price >= 0 &&
        incoming().commission is number;
        
      allow update: if isSignedIn() && (
        // Creator can update details
        (existing().creatorId == request.auth.uid && incoming().creatorId == existing().creatorId && incoming().price is number) ||
        // Admin can approve/reject
        (incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
      
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }

    // --- SALES LOG ---
    match /sales/{saleId} {
      allow read: if isSignedIn() && (
        resource.data.buyerEmail == request.auth.token.email ||
        resource.data.affiliateId == request.auth.uid ||
        // Allow if product belongs to this user (the creator)
        exists(/databases/$(database)/documents/products/$(resource.data.productId)) && 
        get(/databases/$(database)/documents/products/$(resource.data.productId)).data.creatorId == request.auth.uid
      );
      
      allow create: if isSignedIn() && 
        incoming().keys().hasAll(['id', 'productId', 'productTitle', 'amount', 'buyerEmail', 'status', 'paymentMethod', 'date']) &&
        incoming().amount is number && incoming().amount >= 0;
        
      allow update: if isSignedIn() && (
        // Buyer or seller can update status (refunds, completed, etc)
        incoming().amount == existing().amount &&
        incoming().productId == existing().productId
      );
      
      allow delete: if false;
    }

    // --- AFFILIATION RULES ---
    match /affiliations/{affiliationId} {
      allow read: if isSignedIn() && (
        resource.data.affiliateId == request.auth.uid ||
        exists(/databases/$(database)/documents/products/$(resource.data.productId)) && 
        get(/databases/$(database)/documents/products/$(resource.data.productId)).data.creatorId == request.auth.uid
      );
      
      allow create: if isSignedIn() && 
        incoming().affiliateId == request.auth.uid &&
        incoming().productId is string &&
        incoming().linkCode is string;
        
      allow update: if isSignedIn() && (
        incoming().affiliateId == existing().affiliateId &&
        incoming().productId == existing().productId &&
        // Allow adding clicks and sales count
        incoming().clicks is number
      );
      
      allow delete: if isSignedIn() && existing().affiliateId == request.auth.uid;
    }

    // --- TICKETS SUPPORT ---
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (
        resource.data.userEmail == request.auth.token.email ||
        // Or if admin/support
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      allow create: if isSignedIn() && 
        incoming().userEmail == request.auth.token.email;
        
      allow update: if isSignedIn() && (
        incoming().id == existing().id &&
        incoming().subject == existing().subject &&
        // Adjust resolution state or add dialogue
        incoming().status is string
      );
      
      allow delete: if false;
    }

    // --- LANDING PAGES ---
    match /pages/{pageId} {
      allow read: if true; // Anyone can view landing pages
      
      allow create, update: if isSignedIn() && (
        // Allow if product belongs to user
        exists(/databases/$(database)/documents/products/$(incoming().productId)) &&
        get(/databases/$(database)/documents/products/$(incoming().productId)).data.creatorId == request.auth.uid
      );
      
      allow delete: if isSignedIn() && 
        exists(/databases/$(database)/documents/products/$(existing().productId)) &&
        get(/databases/$(database)/documents/products/$(existing().productId)).data.creatorId == request.auth.uid;
    }

    // --- TRANSFER LOGS ---
    match /transfers/{transferId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        // Or admin role
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      allow create: if isSignedIn() && 
        incoming().userId == request.auth.uid &&
        incoming().amount is number && incoming().amount > 0 &&
        incoming().status == 'pending';
        
      allow update: if isSignedIn() && (
        // Admin approval and payout logic
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      allow delete: if false;
    }
  }
}
